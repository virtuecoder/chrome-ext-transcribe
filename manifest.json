{
  "manifest_version": 3,
  "name": "YouTube Transcribe",
  "version": "1.1",
  "description": "Transcribe YouTube videos via `just transcribe`",

  "key": "",

  "permissions": [
    "nativeMessaging"
  ],

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Transcribe — summary model"
  },

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
